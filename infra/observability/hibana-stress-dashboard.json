{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "1. Throughput por Microservicio (Requests / sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (application) (rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[30s]))",
          "legendFormat": "{{application}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        }
      }
    },
    {
      "title": "2. Respuestas HTTP en Inventario & Reservas (201 Created vs 409 Conflict Colisión)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{uri=~\"/api/v1/reservations.*\"}[30s]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "fillOpacity": 25, "lineWidth": 2 }
        }
      }
    },
    {
      "title": "3. Latencia P95 por Microservicio (Umbral SLA < 300ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, application) (rate(http_server_requests_seconds_bucket{uri!~\"/actuator.*\"}[30s]))) * 1000",
          "legendFormat": "P95 {{application}}",
          "refId": "A"
        },
        {
          "expr": "max by (application) (rate(http_server_requests_seconds_sum{uri!~\"/actuator.*\"}[30s]) / rate(http_server_requests_seconds_count{uri!~\"/actuator.*\"}[30s])) * 1000",
          "legendFormat": "Avg {{application}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      }
    },
    {
      "title": "4. Uso de CPU por Microservicio (Métrica Disparadora de HPA en AKS)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "max by (application) (process_cpu_usage) * 100",
          "legendFormat": "CPU % - {{application}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        }
      }
    },
    {
      "title": "5. Memoria JVM Heap Utilizada por Microservicio",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (application) (jvm_memory_used_bytes{area=\"heap\"})",
          "legendFormat": "Heap - {{application}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": { "fillOpacity": 15, "lineWidth": 2 }
        }
      }
    },
    {
      "title": "6. Conexiones Activas de Base de Datos PostgreSQL (HikariCP Pool)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (pool) (hikaricp_connections_active)",
          "legendFormat": "Active - {{pool}}",
          "refId": "A"
        },
        {
          "expr": "sum by (pool) (hikaricp_connections_pending)",
          "legendFormat": "Pending - {{pool}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "fillOpacity": 20, "lineWidth": 2 }
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["hibana", "stress-test", "redlock", "aks-hpa"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "title": "Hibana.tk — High-Concurrency Stress & Redlock Telemetry",
  "uid": "hibana-stress-telemetry",
  "version": 1
}
