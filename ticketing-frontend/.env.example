# Amaryllis Ticketing - Environment Variables Template
# Copy this file to .env.development, .env.production, or .env.local

# API Base URL consumed by frontend services (catalogService, inventoryService, etc.)
# Local: /api/v1 (proxied by Vite to VITE_GATEWAY_URL)
# Prod: https://api.amaryllis-tickets.com/api/v1 (or an Azure Function / Container App endpoint)
VITE_API_BASE_URL=/api/v1

# Target Gateway URL for Vite proxy (local development / preview)
VITE_GATEWAY_URL=http://localhost:8080

# Environment mode: development | staging | production
VITE_APP_ENV=development
