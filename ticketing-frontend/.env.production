# Hibana Ticketing - Production Environment (Azure Free Domain / AKS Ingress)
#
# Uses relative path routing (/api/v1) so the SPA works automatically on any
# Azure free domain (*.cloudapp.azure.com, *.azurestaticapps.net) or public IP
# without requiring a custom registered domain.
VITE_API_BASE_URL=/api/v1
VITE_GATEWAY_URL=
VITE_APP_ENV=production
