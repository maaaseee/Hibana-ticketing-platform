# Hibana.tk Ticketing - Production Environment (Azure / Custom Domain)
#
# Option A - Ingress Reverse Proxy / Azure Front Door / Azure Application Gateway:
# If www.hibana.tk and the Gateway are routed together by Front Door or Azure Static Web Apps:
# VITE_API_BASE_URL=/api/v1
#
# Option B - Dedicated Ingress Domain or Azure Function / Container Apps:
# Point to the public URL of the API Gateway (or Azure Function proxy)
VITE_API_BASE_URL=https://api.hibana.tk/api/v1
VITE_GATEWAY_URL=https://api.hibana.tk
VITE_APP_ENV=production
