{
  "name": "hibana-ticketing-platform",
  "private": true,
  "scripts": {
    "dev": "tilt up",
    "tilt:down": "tilt down",
    "test:all": "bun run scripts/test-all.ts",
    "test:backend:e2e": "bun run scripts/test-backend-e2e.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:status": "docker compose ps",
    "build:frontend": "bun run --cwd ticketing-frontend build",
    "dev:frontend": "bun run --cwd ticketing-frontend dev",
    "test:frontend": "bun run --cwd ticketing-frontend test:unit -- --run",
    "docs:serve:openapi": "npx @scalar/cli serve docs/specs/openapi/gateway-api.yaml",
    "docs:serve:events": "npx @asyncapi/cli start studio -f docs/specs/asyncapi/servicebus-events.yaml",
    "docs:types": "npx openapi-typescript docs/specs/openapi/gateway-api.yaml -o ticketing-frontend/src/api/schema.d.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5"
  }
}
