# =============================================================================
# Hibana Ticketing Platform - Local Dev Environment Variables Template
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# =============================================================================

# PostgreSQL (Azure Database for PostgreSQL Flexible Server emulator / pgvector)
POSTGRES_DB=ticketing_db
POSTGRES_USER=ticketing_admin
POSTGRES_PASSWORD=dev_password_123
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=ticketing_admin
DB_PASSWORD=dev_password_123
DB_NAME=ticketing_db
DB_SSL_MODE=disable

# Redis (Azure Cache for Redis emulator / Redlock / Rate Limiting)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=dev_redis_pass_2026
REDIS_SSL=false

# Virtual Waiting Room & Gateway Perimeter
# Strictly defines the only CORS origins accepted by Spring Cloud Gateway
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
WAITING_ROOM_JWT_SECRET=virtual-waiting-room-hmac-key-2026-minimum-256-bits!
WAITING_ROOM_JWT_ISSUER=waiting-room-engine
WAITING_ROOM_URL=/waiting-room
GATEWAY_HMAC_SECRET=gateway-internal-hmac-secret-2026-minimum-256-bits!

# Azure Entra ID / Floci-AZ OIDC
AZURE_ENTRA_JWKS_URL=http://localhost:4577/00000000-0000-0000-0000-000000000002/discovery/v2.0/keys
AZURE_ENTRA_ISSUER=http://localhost:4577/00000000-0000-0000-0000-000000000002/v2.0
AZURE_ENTRA_AUDIENCE=api://hibana-api

# Azure Key Vault (Local Emulator)
AZURE_KEYVAULT_ENABLED=true
AZURE_KEYVAULT_ENDPOINT=http://localhost:4577/devstoreaccount1-keyvault/

# Azure Service Bus & Storage (Floci-AZ)
AZURE_SERVICEBUS_ENABLED=false
AZURE_SERVICEBUS_CONNECTION_STRING=
AZURE_BLOB_ENABLED=false
AZURE_BLOB_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_NAME=hibana-invoices

# Payment Gateways (MercadoPago)
PAYMENT_MERCADOPAGO_ENABLED=false
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=mercadopago-webhook-secret-key-prod-minimum-256-bits!
